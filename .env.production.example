API_DOMAIN=api.yourdomain.com
COTEE_API_IMAGE=cotee-api:latest

MONGO_ROOT_USERNAME=cotee_admin
MONGO_ROOT_PASSWORD=change-this-mongodb-root-password
MONGO_DATABASE=CoTeeDB

Jwt__SecretKey=change-this-to-a-random-secret-with-64-plus-characters
Jwt__Issuer=CoTeeApi
Jwt__Audience=CoTeeClient
Jwt__ExpirationMinutes=60

AppSettings__BaseUrl=https://api.yourdomain.com
AppSettings__FrontendBaseUrl=https://your-frontend-domain.com
AppSettings__VerificationEmailResendCooldownSeconds=60
AppSettings__AutoVerifyEmailOnRegistration=true

ResendSettings__ApiKey=re_your_api_key
ResendSettings__ApiBaseUrl=https://api.resend.com
ResendSettings__FromEmail=verified-sender@yourdomain.com
ResendSettings__FromName=CoTee Account

Swagger__Enabled=true

MomoSettings__PartnerCode=your-momo-partner-code
MomoSettings__AccessKey=your-momo-access-key
MomoSettings__SecretKey=your-momo-secret-key
MomoSettings__Endpoint=https://test-payment.momo.vn/v2/gateway/api/create
MomoSettings__RedirectUrl=https://your-frontend-domain.com/payment-result
MomoSettings__IpnUrl=https://api.yourdomain.com/api/orders/momo-ipn

OpenAi__ApiKey=your-openai-api-key
OpenAi__ChatModel=gpt-4o-mini
OpenAi__ImageModel=gpt-image-1.5
OpenAi__UseMock=false

Google__Enabled=false
Google__ClientId=your-google-oauth-client-id.apps.googleusercontent.com
